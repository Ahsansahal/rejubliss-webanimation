# Optional Email & Webhook Configuration for Project Inquiries (/api/inquiry)
# When RESEND_API_KEY is configured, submitted briefs are emailed directly to INQUIRY_TO_EMAIL.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=info@rejubliss.co.uk
INQUIRY_FROM_EMAIL="Rejubliss Studio <notifications@rejubliss.co.uk>"

# Optional CRM / Slack / Automation Webhook URL
INQUIRY_WEBHOOK_URL=

# Canonical Site Origin (matches Vercel primary domain to prevent canonical/sitemap redirect loops)
NEXT_PUBLIC_SITE_URL=https://www.rejubliss.co.uk

# Optional Analytics & Search Engine Verification
# Google Tag Manager containers GTM-5W9FRRJR and GTM-WXPQB7DN load automatically via AnalyticsTracker.
# Set NEXT_PUBLIC_GA_MEASUREMENT_ID (e.g. G-XXXXXXXXXX) only if using an additional standalone GA4 property.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
